# Server Port
PORT=8080

# PostgreSQL & pgvector Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=face_attendance
POSTGRES_PORT=5432

# Database URL
# For Docker Compose (using container service name 'postgres'):
DATABASE_URL=postgres://postgres:postgres@postgres:5432/face_attendance?sslmode=disable
# For Localhost outside Docker:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/face_attendance?sslmode=disable

# JWT Secret Key
JWT_SECRET=super-secret-jwt-key-replace-in-production

# AI Engine Service URL (InsightFace microservice)
# Via Docker caddy_net / container network:
AI_ENGINE_URL=http://faceattendance-ai-engine:5000
# For Localhost outside Docker:
# AI_ENGINE_URL=http://localhost:5000

# Cosine similarity threshold for facial verification (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.65
